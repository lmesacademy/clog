{
  "name": "@lmes/clog",
  "version": "0.1.1",
  "description": "Levelled logger that reports the real caller line and ships to Better Stack",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/lmesacademy/clog",
  "license": "MIT",
  "keywords": [
    "logger",
    "logtail",
    "betterstack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json && tsc -p tsconfig.module.json",
    "test": "bun run build && bun test",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "example": "bun example/index.ts",
    "release": "bun run test && bunx standard-version && bun publish"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.30"
  },
  "dependencies": {
    "@logtail/node": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "prettier": "^2.8.8",
    "standard-version": "^9.5.0",
    "typescript": "^5.6.3"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true
  }
}
